# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=content_quality
MYSQL_USER=trustops
MYSQL_PASSWORD=trustops

# Gateway runtime
GATEWAY_ADDR=:8080
STORAGE_BACKEND=mysql
MYSQL_DSN=trustops:trustops@tcp(mysql:3306)/content_quality?parseTime=true
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
RABBITMQ_URL=amqp://trustops:trustops@rabbitmq:5672/
RABBITMQ_QUEUE=content.events.ingest
CASE_CACHE_TTL_SECONDS=300
OUTBOX_POLL_INTERVAL_SECONDS=2
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=3
OUTBOX_RETRY_BASE_SECONDS=2

# Worker runtime
WORKER_RABBITMQ_URL=amqp://trustops:trustops@rabbitmq:5672/
WORKER_QUEUE=content.events.ingest
WORKER_CONSUMER_TAG=content-quality-worker
